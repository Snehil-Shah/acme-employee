# Model key for the agents (GitAgent reads it from the environment).
ANTHROPIC_API_KEY=
# Optional: override the agents' model, e.g. a cheaper one for rehearsals.
# AGENT_MODEL=anthropic:claude-haiku-4-5
# The company repo this workbench drives. Defaults to the repo it lives in (..).
EMPLOYEE_REPO=..
# Optional: mirror the company repo to GitHub as a GitHub App (pushes and pull
# requests show as the app's bot). The app needs Contents and Pull requests
# read/write on that one repo.
# GITHUB_REPO=owner/acme-employee
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=../the-employee.private-key.pem
